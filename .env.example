# Copy to .env. No key is required: perplexity-web, gemini-web, brave-web and duckai-web run through
# your installed Chrome, and without ANTHROPIC_API_KEY the heuristic judge is used (labelled in the report).
# ANTHROPIC_API_KEY switches on the model judge and the claude engine. The other keys add API engines.
# With keys set, `aivs scan --engines api` runs every keyed engine with no Chrome at all (minutes, not 1.5 h).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=                    # grok (API). grok-web needs no key: `aivs login grok` once

# Optional model overrides
# AIVS_JUDGE_MODEL=claude-sonnet-5-5
# AIVS_CLAUDE_MODEL=claude-sonnet-5-5
# AIVS_OPENAI_MODEL=gpt-6.2-astra
# AIVS_GEMINI_MODEL=gemini-3.8-flash
# AIVS_PERPLEXITY_MODEL=perplexity/sonar   # Agent API catalog id; plain 'sonar' was retired
# AIVS_XAI_MODEL=grok-4.7

# Browser engines
# AIVS_BROWSER_HEADLESS=1          # default off: a visible Chrome window (Brave and Duck.ai show bot checks headless)
# AIVS_BROWSER_CHANNEL=chrome      # or chromium after `playwright install chromium`
# AIVS_BROWSER_PROFILE=~/.aivs/chrome-profile
# AIVS_BROWSER_PACE_S=4            # seconds between questions
